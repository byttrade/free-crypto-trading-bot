# Copy to .env (never commit it) and fill in the keys of the account you trade.
# Variable names: <EXCHANGE>_<DEMO|REAL>_API_KEY / _SECRET / _PASSWORD (passphrase, where the exchange has one).
# Hyperliquid: <...>_WALLET_ADDRESS and <...>_PRIVATE_KEY instead.
BYBIT_DEMO_API_KEY=
BYBIT_DEMO_SECRET=
OKX_DEMO_API_KEY=
OKX_DEMO_SECRET=
OKX_DEMO_PASSWORD=
